/*
5. Crie uma função chamada `calcularMedia` que recebe um array de números e
   retorna a média desses valores.
*/

let media = 0
let divisor = 0
function averageArray(...nums){
for(let i=0; i< nums.length; i++){
    media += nums[i];
    divisor += i;
    
}
return media/divisor
}
console.log(averageArray(1,3,5))

/*
6. Crie uma função chamada `maiorNumero` que recebe um array de números e retorna
   o maior valor presente no array.
*/

function majorNumber(...nums){
   let nmajor = 0
   for(let i = 0; i < nums.length; i++){
      if (nums[i] > nmajor) {
         nmajor = nums[i]
      }
   }
      return `O maior numero é ${nmajor}`
}

console.log(majorNumber(2,44,4,11))


